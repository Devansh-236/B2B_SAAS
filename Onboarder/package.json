{
  "name": "onboarder-api",
  "version": "1.0.0",
  "description": "Employee Onboarding Management System with FastAPI",
  "main": "main.py",
  "bin": {
    "onboarder": "./start_server.sh"
  },
  "scripts": {
    "start": "python main.py",
    "dev": "python main.py",
    "install-deps": "pip install -r requirements.txt",
    "setup": "pip install -r requirements.txt && python -c \"from onboarder.database_manager import DatabaseManager; db = DatabaseManager(); print('Database initialized')\"",
    "test": "python -m pytest",
    "lint": "flake8 onboarder/ main.py",
    "format": "black onboarder/ main.py"
  },
  "keywords": [
    "onboarding",
    "employee",
    "hr",
    "automation",
    "fastapi",
    "python",
    "ai-agents"
  ],
  "author": "Onboarder Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/onboarder.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "preferGlobal": true,
  "files": [
    "onboarder/",
    "main.py",
    "requirements.txt",
    "start_server.sh",
    "README.md",
    "LICENSE"
  ]
}
