# Onboarder Environment Configuration
# Copy this file to .env and fill in your actual values

# Google Gemini API Configuration (required)
GEMINI_API_KEY=your_gemini_api_key_here
# Per-request timeout (seconds) for Gemini calls
ONBOARDER_LLM_TIMEOUT=30

# API Server
# Interface to bind. Keep 127.0.0.1 unless you need remote access (then also set ONBOARDER_API_KEY).
ONBOARDER_HOST=127.0.0.1
ONBOARDER_PORT=8050
# Auto-reload on code changes (development only)
ONBOARDER_RELOAD=false
# Comma-separated list of browser origins allowed by CORS ("*" allows any origin, without credentials)
ONBOARDER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8050,http://127.0.0.1:8050
# If set, every data endpoint requires the header "X-API-Key: <value>"
ONBOARDER_API_KEY=

# Storage (relative paths are resolved against the Onboarder directory)
ONBOARDER_DB_PATH=onboarding.db
DOCUMENT_OUTPUT_DIR=generated_documents

# ---------------------------------------------------------------------------
# Planned / not yet used: the settings below are NOT read by the code today.
# Emails, calendar invites and company details are currently simulated.
# ---------------------------------------------------------------------------
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# GOOGLE_CALENDAR_CREDENTIALS_FILE=path/to/credentials.json
# GOOGLE_CALENDAR_TOKEN_FILE=path/to/token.json
# COMPANY_NAME=Your Company Name
# COMPANY_EMAIL=hr@yourcompany.com
# COMPANY_DOMAIN=yourcompany.com
# LOG_LEVEL=INFO
# LOG_FILE=onboarder.log
